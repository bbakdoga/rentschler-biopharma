# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Local secrets and environment settings
.env
.env.*
!.env.example

# Runtime databases and SQLite sidecar files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Generated OCR pages
temp_pages/

# Confidential input documents and generated reports (ANY location).
# This repo must never contain real batch records, answer keys, or exports.
*.pdf
*.xlsx
*.xls
*.csv
*.tif
*.tiff

# Logs
*.log

# IDE, assistant, and operating-system files
.vscode/
.idea/
.claude/
.DS_Store
